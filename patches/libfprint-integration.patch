+static void
+fpi_image_device_custom_image_captured (FpImageDevice *self, FpImage *image)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpImageDeviceClass *klass = FP_IMAGE_DEVICE_GET_CLASS (self);
+  FpDevice *device = FP_DEVICE (self);
+  FpiDeviceAction action = fpi_device_get_current_action (device);
+  g_autoptr(FpImage) owned_image = image;
+  g_autoptr(GError) error = NULL;
+
+  /* Mirror completion of the asynchronous NBIS job.  The temporary active
+   * flag ensures state has moved to AWAIT_FINGER_OFF before enrollment can
+   * request final deactivation. */
+  priv->minutiae_scan_active = FALSE;
+
+  if (action == FPI_DEVICE_ACTION_CAPTURE)
+    {
+      priv->capture_image = g_steal_pointer (&owned_image);
+      fp_image_device_maybe_complete_action (self, NULL);
+      return;
+    }
+
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      FpPrint *enroll_print;
+      fpi_device_get_enroll_data (device, &enroll_print);
+      if (klass->enroll_image (self, enroll_print, owned_image, &error))
+        priv->enroll_stage++;
+
+      fpi_device_enroll_progress (device, priv->enroll_stage,
+                                  error ? NULL : enroll_print,
+                                  g_steal_pointer (&error));
+      if (priv->enroll_stage == fp_device_get_nr_enroll_stages (device))
+        {
+          fp_image_device_maybe_complete_action (self, NULL);
+          fpi_image_device_deactivate (self, FALSE);
+        }
+      else
+        fp_image_device_enroll_maybe_await_finger_on (self);
+      return;
+    }
+
+  if (action == FPI_DEVICE_ACTION_VERIFY)
+    {
+      FpPrint *template;
+      FpiMatchResult result;
+      fpi_device_get_verify_data (device, &template);
+      result = klass->match_image (self, template, owned_image, &error);
+      fpi_device_verify_report (device, result, NULL, g_steal_pointer (&error));
+      fp_image_device_maybe_complete_action (self, NULL);
+      return;
+    }
+
+  if (action == FPI_DEVICE_ACTION_IDENTIFY)
+    {
+      GPtrArray *templates;
+      FpPrint *match = NULL;
+      fpi_device_get_identify_data (device, &templates);
+      for (guint i = 0; i < templates->len && !error; i++)
+        if (klass->match_image (self, g_ptr_array_index (templates, i),
+                                owned_image, &error) == FPI_MATCH_SUCCESS)
+          {
+            match = g_ptr_array_index (templates, i);
+            break;
+          }
+      fpi_device_identify_report (device, match, NULL, g_steal_pointer (&error));
+      fp_image_device_maybe_complete_action (self, NULL);
+      return;
+    }
+
+  g_assert_not_reached ();
+}
+
 /*********************************************************/
 /* Private API */
 
@@ -492,6 +565,15 @@ fpi_image_device_image_captured (FpImageDevice *self, FpImage *image)
 
   g_debug ("Image device captured an image");
 
+  if (FP_IMAGE_DEVICE_GET_CLASS (self)->enroll_image &&
+      FP_IMAGE_DEVICE_GET_CLASS (self)->match_image)
+    {
+      priv->minutiae_scan_active = TRUE;
+      fp_image_device_change_state (self, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF);
+      fpi_image_device_custom_image_captured (self, image);
+      return;
+    }
+
   priv->minutiae_scan_active = TRUE;
 
